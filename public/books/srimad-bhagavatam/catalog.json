    "sanskrit": {
      "title": "श्रीमद्भागवतपुराणम्",
      "description": "महर्षिवेदव्यासप्रणीतं द्वादशस्कन्धात्मकं श्रीमद्भागवतपुराणम्। अस्मिन् महापुराणे भगवतो विष्णोः लीलावताराणां तथा शुद्धभक्तेः महिमा वर्णितः।",
      "shlokaLabel": "अध्यायः"
    },
    "kannada": {
      "title": "ಶ್ರೀಮದ್ಭಾಗವತಮ್",
      "description": "ಮಹರ್ಷಿ ವೇದವ್ಯಾಸ ವಿರಚಿತ ೧೨ ಸ್ಕಂಧಗಳ ಮಹೋನ್ನತ ಮಹಾಪುರಾಣ. ಶ್ರೀಮನ್ನಾರಾಯಣನ ದಿವ್ಯ ಲೀಲೆಗಳು ಮತ್ತು ಭಕ್ತಿ ಮಾರ್ಗದ ಪವಿತ್ರ ಗ್ರಂಥ.",
      "shlokaLabel": "ಅಧ್ಯಾಯ"
    },
    "english": {
      "title": "Srimad Bhagavatam",
      "description": "A 12-Skanda Mahapurana composed by Maharsi Vedavyasa glorifying Lord Vishnu and pure devotion.",
      "shlokaLabel": "Adhyaya"
    }
  },
